APP_NAME="Cellphone Repair Shop API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_PH

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=cp_repair_db
DB_USERNAME=root
DB_PASSWORD=

# No session/cookie state exists in this API (Rule Zero - stateless bearer
# tokens only via Sanctum). 'array' keeps the driver harmless if any package
# ever touches the session facade; it is never started for API requests.
SESSION_DRIVER=array
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# 'database' uses the cache/jobs tables the migrations already create, so a
# local box needs no Redis. Switch to redis once 6379 is actually served.
QUEUE_CONNECTION=database
CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

# predis, not phpredis - no native extension required.
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Comma-separated browser origins allowed to call the API cross-origin.
# dev-up.ps1 appends the friendly proxy host automatically.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

HORIZON_ALLOWED_IPS=127.0.0.1
TELESCOPE_ENABLED=false
